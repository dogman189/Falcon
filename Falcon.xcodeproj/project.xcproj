    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "Falcon",
      "target-membership": [
        "Falcon",
      ],
      "membership-exceptions": [
        {
          "target": "Falcon",
          "exclusions": [
            "reVCDOS/dist/GamepadEmulator.js",
