            "reVCDOS/dist/jsdos-cloud-sdk.js",
            "reVCDOS/dist/modules/asm_consts/en.js",
            "reVCDOS/dist/modules/asm_consts/ru.js",
            "reVCDOS/dist/modules/audio.js",
            "reVCDOS/dist/modules/cheats.js",
            "reVCDOS/dist/modules/events.js",
            "reVCDOS/dist/modules/fetch.js",
            "reVCDOS/dist/modules/fs.js",
            "reVCDOS/dist/modules/graphics.js",
            "reVCDOS/dist/modules/loader.js",
            "reVCDOS/dist/modules/main.js",
